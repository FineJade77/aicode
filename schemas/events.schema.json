{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicode.dev/schemas/events.schema.json",
  "title": "aicode Runtime Event",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "description": "Machine-readable event type, such as plan.created or final."
    },
    "session_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
