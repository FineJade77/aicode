{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicode.dev/schemas/eval-trace.schema.json",
  "x-aicode-contract-version": "1.0",
  "title": "aicode Eval Trace Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "trace_id",
    "task",
    "replay",
    "source_versions",
    "model_profile",
    "budgets",
    "workspace",
    "run",
    "model_calls",
    "approvals",
    "events",
    "audit",
    "grade",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": "1.0"},
    "trace_id": {"type": "string", "minLength": 16},
    "task": {"type": "object"},
    "replay": {"type": "object"},
    "source_versions": {"type": "object"},
    "model_profile": {"type": "object"},
    "budgets": {"type": "object"},
    "workspace": {"type": "object"},
    "run": {"type": "object"},
    "model_calls": {"type": "array"},
    "approvals": {"type": "array"},
    "events": {"type": "array"},
    "audit": {"type": "array"},
    "grade": {"type": "object"},
    "metrics": {"type": "object"}
  },
  "additionalProperties": false
}
