{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicode.dev/schemas/eval-task.schema.json",
  "x-aicode-contract-version": "1.0",
  "title": "aicode Eval Task",
  "type": "object",
  "required": [
    "contract_version",
    "task_id",
    "suite",
    "description",
    "fixture",
    "user_request",
    "profile",
    "budgets",
    "checks"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "default",
        "review",
        "diff",
        "test",
        "explain",
        "commit_message"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trust": {
      "enum": [
        "trusted",
        "untrusted"
      ]
    },
    "approval_policy": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "accept",
          "reject"
        ]
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "context_window",
        "max_output_tokens"
      ],
      "properties": {
        "provider": {
          "enum": [
            "scripted",
            "anthropic",
            "openai_compatible"
          ]
        },
        "model": {
          "type": "string"
        },
        "context_window": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "input_per_1m": {
          "type": "number",
          "minimum": 0
        },
        "output_per_1m": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_model_calls",
        "max_tokens",
        "max_cost",
        "wall_time_seconds"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "history_seed": {
      "type": "object",
      "properties": {
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "chars_per_message": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "provider_mode": {
      "enum": [
        "scripted",
        "live"
      ],
      "description": "'scripted' replays model_script and proves the Agent Loop is correct; 'live' calls a real model and measures whether the Agent finishes the task. Defaults to 'scripted'."
    },
    "live_model": {
      "type": "string",
      "minLength": 1,
      "description": "Live mode only: the model actually called. profile.model still drives context window and pricing."
    },
    "model_script": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "purpose": {
            "enum": [
              "main",
              "reviewer",
              "summarizer"
            ]
          },
          "text": {
            "type": "string"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "arguments"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "arguments": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object"
    },
    "trace_redactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
