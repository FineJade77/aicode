{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicode.dev/schemas/config.schema.json",
  "title": "aicode Project Config",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Project display name, used only as a context hint."
    },
    "commands": {
      "type": "object",
      "description": "Known project commands injected into the prompt. commands.test/build/lint are also used for Docker sandbox detection, and commands.test is used by aicode test.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "protectedPaths": {
      "type": "array",
      "description": "Additional protected-path globs. Built-in .env, SSH/GPG/cloud credential, and private-key rules always apply and cannot be removed by repository configuration. Project Trust is also external to repository configuration.",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "largeDiffThreshold": {
          "type": "integer",
          "minimum": 50,
          "maximum": 50000
        },
        "maxFindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": true
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "mode"],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["read_only"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
