{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicode.dev/schemas/config.schema.json",
  "title": "aicode Project Config",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "项目显示名，仅作为上下文提示。"
    },
    "defaultLanguage": {
      "type": "string",
      "enum": ["zh-CN", "en-US"],
      "description": "项目级默认交互语言；创建 session 时优先于用户级 ui.language。"
    },
    "commands": {
      "type": "object",
      "description": "项目常用命令记忆，会注入 prompt；commands.test 也用于 aicode test。",
      "additionalProperties": {
        "type": "string"
      }
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "largeDiffThreshold": {
          "type": "integer",
          "minimum": 50,
          "maximum": 50000
        },
        "maxFindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": true
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "mode"],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["read_only"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
