    "allowed_changed_paths": [
      "stage_b.py",
      "stage_c.py",
      "stage_d.py",
      "stage_e.py",
      "stage_f.py",
      "stage_g.py",
      "stage_h.py",
      "stage_i.py",
      "stage_j.py",
      "stage_k.py",
      "stage_l.py",
      "start.py"
    ],
    "forbidden_changed_paths": [
      "test_trace.py",
      "trace.py"
    ],
    "required_events": [
      "edit.applied",
      "usage.recorded",
      "final"
    ],
    "required_audit_events": [
      "tool.started",
