  "checks": {
    "test_commands": [["python3", "-m", "unittest", "-q"]],
    "files": [
      {
        "path": "calc.py",
        "contains": ["return left + right"],
        "not_contains": ["return left - right"]
      }
    ],
    "allowed_changed_paths": ["calc.py"],
    "forbidden_changed_paths": [".env"],
    "required_events": [
      "approval.requested",
